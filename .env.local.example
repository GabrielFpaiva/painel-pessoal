# Copie para .env.local. Os valores locais saem de `supabase status`.

# Públicos por design — vão para o bundle do client. Quem protege a linha é a RLS.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Passa por cima da RLS. Só no servidor, só no resgate de convite (ADR-04).
# Nunca prefixe com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# GitHub OAuth App (Settings > Developer settings > OAuth Apps).
# Callback local: http://127.0.0.1:54321/auth/v1/callback
SUPABASE_AUTH_GITHUB_CLIENT_ID=
SUPABASE_AUTH_GITHUB_SECRET=
